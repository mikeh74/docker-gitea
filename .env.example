# Copy this file to .env and replace the placeholder values before starting the stack.

# MySQL root password (used by the db service only)
MYSQL_ROOT_PASSWORD=change-me-root-password

# Password for the MySQL user "gitea"
MYSQL_PASSWORD=change-me-db-password

# Same password as MYSQL_PASSWORD; Gitea uses it to connect to the database
GITEA_DB_PASSWORD=change-me-db-password
